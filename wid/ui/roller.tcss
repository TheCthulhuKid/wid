Screen { background: $surface; }
#workspace { height: 1fr; }
#configuration { width: 2fr; padding: 0 1; border: solid $primary; }
KitControls, ItemsGroup, SessionName, SessionFile, NotesGroup { height: auto; }
#details, #details TabPane { height: auto; }
Collapsible { padding: 0 0 1 0; border-top: none; }
Collapsible > Contents { padding: 0; }
#details TabPane { padding: 0; }
.field { height: auto; }
#profile-fields { height: 4; }
#profile-fields .field { width: 1fr; margin-right: 1; }
#game-controls { width: 28; height: 4; }
#start-game, #load-session { width: 14; margin-top: 1; }
#character-fields { grid-size: 3; grid-rows: auto; grid-gutter: 0 1; height: auto; }
#attribute-ranks { height: auto; }
.attribute-row { height: 3; }
.attribute-row Label { width: 13; height: 3; content-align: left middle; }
#attribute-ranks Select { width: 8; }
.attribute-row Button { width: 8; min-width: 8; margin-left: 1; }
#test-options { height: 4; }
#fear-field { width: 9; margin-right: 1; }
#assisted-field { width: 10; }
#expertise-field { width: 1fr; }
#expertise-controls { height: 3; }
#expertise { width: 4; }
#name-expertise { width: 1fr; min-width: 0; }
#apply-expertise { width: 8; min-width: 8; }
#test-options Checkbox { height: 3; padding: 0; border: tall transparent; }
.button-row { height: 3; }
.button-row Button { margin-right: 1; }
StrainGroup { height: auto; margin: 1 0; }
.strain-row { height: 3; }
.strain-checks { width: 25; height: 3; }
.strain-row Checkbox { padding: 0; }
.strain-row Checkbox.-on { background: $success 35%; border: tall $success; }
.strain-row Checkbox.-on > .toggle--button {
    background: $success;
    color: $text;
    text-style: bold;
}
.strain-row .strain-ending.-on { background: $error 35%; border: tall $error; }
.strain-row .strain-ending.-on > .toggle--button { background: $error; }
.strain-box { width: 4; }
.strain-ending { width: 13; }
.strain-row Input { width: 1fr; min-width: 30; }
.compact .strain-row { layout: vertical; height: 6; }
#output { width: 1fr; padding: 0 1; }
#actions { height: 3; }
#actions Button { width: 1fr; min-width: 0; }
RollerGroup { height: 1fr; padding: 1; border: solid $primary; }
Label, Static { height: auto; }
Select, Input { width: 1fr; }
#session-notes { width: 1fr; height: 8; }
#notes-preview-panel { display: none; height: 8; border: solid $primary; }
#notes-toolbar { height: 3; }
#notes-toolbar Button { width: 1fr; min-width: 0; }
Checkbox { width: 1fr; height: auto; }
#items, #item-rows, #powers, #tech-controls, #reroll-controls, #attribute-setup { height: auto; }
#tech-scenario-row, #standing-field, #resource-field, #resource-row { height: auto; }
#resource-row Button { min-width: 5; width: auto; }
#corruption-field, #corruption-row { height: auto; }
#corruption-amount { width: 10; }
#resource-count { width: 7; padding: 1 1; }
#crafted-row #lose-crafted-item { width: 8; }
#standing { height: 1; }
#tech-attributes { width: 1fr; padding: 1 0; }
#item-target-row { height: 3; }
#item-target-row Label { width: 14; padding: 1 0; }
#item-target { width: 16; }
.named-bonus { height: 4; }
.named-bonus .field { width: 1fr; }
.named-bonus Button { width: 10; min-width: 0; margin: 1 0 0 1; }
.named-bonus PowerToggle { width: 13; margin: 1 0 0 1; }
.named-bonus SacrificeButton { width: 13; }
#feedback { color: $warning; max-height: 5; overflow-y: auto; }
#pool, #summary, #resources { margin: 1 0; }
#pool { margin: 0; }
#history-panel { display: none; height: 7; }
#history-statistics { height: auto; }
#log { height: 1fr; border: solid $secondary; }
Button { min-width: 14; }
ConfirmSessionAction, LoadGame, ExportHistory, SpendResources {
    align: center middle; background: $background 80%;
}
#confirmation, #load-dialog, #export-dialog, #spend-dialog {
    width: 54; max-width: 100%; height: auto; padding: 1 2; border: thick $warning;
}
#confirmation Button, #load-dialog Button, #export-dialog Button, #spend-dialog Button {
    width: 1fr; margin-top: 1;
}
/* Wide enough for the longest effect on one line; in a short terminal the gaps go to fit. */
#spend-dialog { width: 72; }
.short #spend-dialog Button { margin-top: 0; }

/* Short terminals: one-row controls, so the attributes and options fit without scrolling. */
.short #profile-fields, .short #game-controls { height: 2; }
.short .attribute-row, .short .attribute-row Label { height: 1; }
.short .attribute-row Button { margin-left: 1; }
.short #test-options { height: 2; }
.short #expertise-controls { height: 1; }
.short #test-options Checkbox { height: 1; border: none; }
.short #item-target-row { height: 1; }
.short #item-target-row Label { padding: 0; }
.short .named-bonus { height: 2; }
.short .named-bonus Button, .short .named-bonus PowerToggle { margin: 0 0 0 1; }
.short .button-row, .short #notes-toolbar { height: 1; }

/* The GM's scene tab. */
SceneGroup { height: auto; }
#pc-row { height: 3; }
#pc-row Label { width: 6; padding: 1 0; }
#pc-count { width: 8; }
#new-danger { height: 4; }
#new-danger .field { width: 1fr; margin-right: 1; }
#class-field, #difficulty-field { width: 16; }
#add-danger { margin-top: 1; }
#danger-rows { height: auto; }
.danger-row { height: auto; margin-top: 1; }
.danger-controls { height: 3; }
.danger-controls RemoveDangerButton { width: 10; min-width: 10; margin-left: 1; }
#scene-summary { margin: 1 0; }
#threshold-row { height: 4; }
#amount-field { width: 10; margin-right: 1; }
#threshold-row Button { margin-top: 1; margin-right: 1; }
#hostile-row { height: 3; }
#task-row { height: 4; }
#task-field { width: 12; margin-right: 1; }
#task-strain { margin-top: 1; }
#hostile { width: 1fr; padding: 0; border: tall transparent; }
ActivationGroup { height: 1fr; padding: 1; border: solid $primary; }
#activation { margin-bottom: 1; }
#loadout { height: auto; }
.short #pc-row { height: 1; }
.short #pc-row Label { padding: 0; }
.short #new-danger, .short #threshold-row { height: 2; }
.short #add-danger, .short #threshold-row Button, .short #task-strain { margin-top: 0; }
.short #task-row { height: 2; }
.short .danger-row { margin-top: 0; }
.short .danger-controls, .short #hostile-row { height: 1; }
.short #hostile { height: 1; border: none; }
.short #scene-summary { margin: 0; }

/* Danger theme: cream paper behind lavender fields, with a charcoal title bar. */
.-theme-danger Screen { background: $background; }
.-theme-danger Header { background: $secondary; color: $background; }
